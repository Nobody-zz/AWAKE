{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "awake.worldbook.event-record.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "occurredAt",
    "eventType",
    "domain",
    "visibility",
    "facts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "awake.worldbook.event-record.v1"
    },
    "eventId": {
      "$ref": "common.schema.json#/$defs/stable_id"
    },
    "eventKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "eventType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "domain": {
      "$ref": "common.schema.json#/$defs/event_domain"
    },
    "actorIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/stable_id"
      },
      "uniqueItems": true
    },
    "locationIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/stable_id"
      },
      "uniqueItems": true
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "min_detail"
      ],
      "properties": {
        "scope": {
          "$ref": "common.schema.json#/$defs/scope"
        },
        "min_detail": {
          "$ref": "common.schema.json#/$defs/detail_level"
        },
        "identity_ids": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/stable_id"
          },
          "uniqueItems": true
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "factId",
          "text"
        ],
        "properties": {
          "factId": {
            "$ref": "common.schema.json#/$defs/stable_id"
          },
          "text": {
            "$ref": "common.schema.json#/$defs/localized"
          },
          "entryId": {
            "$ref": "common.schema.json#/$defs/stable_id"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  }
}
