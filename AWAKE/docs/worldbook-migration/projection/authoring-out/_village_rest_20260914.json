{
 "castle_village_B1_1": {
  "sid": "castle_village_B1_1",
  "en": "Ab Comer",
  "cn": "阿布·科梅尔",
  "culture": "battania",
  "desc_cn": "阿布·科梅尔坐落于穿过乌卡利翁高原的特朗河上游的陡峭处。当地各部落会在山坡上种植葡萄，用以酿造一种深受帝国与瓦兰迪亚贵族欢迎的白葡萄酒。",
  "ntok": "Settlements.Settlement.name.castle_village_B1_1",
  "dtok": "Settlements.Settlement.text.castle_village_B1_1"
 },
 "castle_village_B1_2": {
  "sid": "castle_village_B1_2",
  "en": "Inveth",
  "cn": "因韦斯",
  "culture": "battania",
  "desc_cn": "因韦斯位于特朗河与埃蒂尔河从乌卡利翁地块翻滚而出处，这两条河汇合流入瓦兰迪亚中央的平原。该地周围环绕的丘陵适合种植小麦。",
  "ntok": "Settlements.Settlement.name.castle_village_B1_2",
  "dtok": "Settlements.Settlement.text.village_B5_4"
 },
 "castle_village_B2_1": {
  "sid": "castle_village_B2_1",
  "en": "Llanoc Hen",
  "cn": "拉诺克·亨",
  "culture": "battania",
  "desc_cn": "拉诺克·亨位于乌卡利翁地块的高山山脊处。村民们都是熟练的养猪户，他们下山后有两条路，一条向西通往瓦兰迪亚，另一条向东通往帝国。",
  "ntok": "Settlements.Settlement.name.castle_village_B2_1",
  "dtok": "Settlements.Settlement.text.castle_village_B2_1"
 },
 "castle_village_B2_2": {
  "sid": "castle_village_B2_2",
  "en": "Cantrec",
  "cn": "坎特雷克",
  "culture": "battania",
  "desc_cn": "坎特雷克坐落于帝国领土通往乌喀利昂高原处多岩的巴拉索格峡谷之中。当地土壤并不十分肥沃，但高处的灌木林地很适合养猪。",
  "ntok": "Settlements.Settlement.name.castle_village_B2_2",
  "dtok": "Settlements.Settlement.text.castle_village_B2_2"
 },
 "castle_village_B3_1": {
  "sid": "castle_village_B3_1",
  "en": "Druimmor",
  "cn": "德鲁伊莫尔",
  "culture": "battania",
  "desc_cn": "德鲁伊莫尔坐落于摩康谷——一道分割乌卡利翁高原与埃博半岛的裂谷之中。矿工在当地的山边裂缝处发现了银矿。",
  "ntok": "Settlements.Settlement.name.castle_village_B3_1",
  "dtok": "Settlements.Settlement.text.castle_village_B3_1"
 },
 "castle_village_B3_2": {
  "sid": "castle_village_B3_2",
  "en": "Tor Melina",
  "cn": "托·梅利纳",
  "culture": "battania",
  "desc_cn": "托·梅利纳坐落于乌卡利翁地块西北部阴暗林丘内的一块沼泽盆地中。村民们从潮湿的泥土中提取黏土，卖给附近城镇的陶工。",
  "ntok": "Settlements.Settlement.name.castle_village_B3_2",
  "dtok": "Settlements.Settlement.text.village_B3_4"
 },
 "castle_village_B4_1": {
  "sid": "castle_village_B4_1",
  "en": "Pendraic",
  "cn": "潘德拉克",
  "culture": "battania",
  "desc_cn": "潘德拉克坐落在乌卡利翁北部的陡坡上，面对着瓦尔切格湾。该地频繁受到冷风与瓦兰迪亚、巴旦尼亚、斯特吉亚劫掠队的侵袭，小规模战斗时有发生。养猪的村民们一听到警戒号角声，就把畜群赶进山中的藏身处。",
  "ntok": "Settlements.Settlement.name.castle_village_B4_1",
  "dtok": "Settlements.Settlement.text.castle_village_B4_1"
 },
 "castle_village_B4_2": {
  "sid": "castle_village_B4_2",
  "en": "Lindorn",
  "cn": "林杜恩",
  "culture": "battania",
  "desc_cn": "林杜恩坐落于“林·泰瓦尔”——即暗湖的西北面绿色山丘上。周围的农田里种植着小麦和大麦。",
  "ntok": "Settlements.Settlement.name.castle_village_B4_2",
  "dtok": "Settlements.Settlement.text.village_B2_5"
 },
 "castle_village_B5_1": {
  "sid": "castle_village_B5_1",
  "en": "Rhemtoil",
  "cn": "雷姆托伊尔",
  "culture": "battania",
  "desc_cn": "雷姆托伊尔位于乌卡利翁高原东部悬崖的裂隙下，靠近巴旦尼亚人称为“米尔”的弥戎河的源头。这里是巴旦尼亚土壤最肥沃的地方，小麦收成很好。",
  "ntok": "Settlements.Settlement.name.castle_village_B5_1",
  "dtok": "Settlements.Settlement.text.castle_village_B5_1"
 },
 "castle_village_B5_2": {
  "sid": "castle_village_B5_2",
  "en": "Claig Ban",
  "cn": "克莱格·班",
  "culture": "battania",
  "desc_cn": "克莱格·班坐落于乌卡利翁地块的一堵悬崖下。村民们从旁边的米尔河中收集黏土，卖给巴旦尼亚各城镇的陶工。",
  "ntok": "Settlements.Settlement.name.castle_village_B5_2",
  "dtok": "Settlements.Settlement.text.castle_village_B5_2"
 },
 "castle_village_B6_1": {
  "sid": "castle_village_B6_1",
  "en": "Flintolg",
  "cn": "弗林托格",
  "culture": "battania",
  "desc_cn": "弗林托格坐落于乌卡利翁地块东部的高山山顶处。当地土壤贫瘠，但树木生得粗壮，使得这里成为巴旦尼亚的木材主要产地。",
  "ntok": "Settlements.Settlement.name.castle_village_B6_1",
  "dtok": "Settlements.Settlement.text.castle_village_B6_1"
 },
 "castle_village_B6_2": {
  "sid": "castle_village_B6_2",
  "en": "Glintor",
  "cn": "格林托尔",
  "culture": "battania",
  "desc_cn": "格林托尔俯瞰着湍急的费尔河，来自泰瓦尔湖的水流由此汇入瓦尔切格湾。当地草甸养出的马匹备受北方斯特吉亚强盗与商贩们的喜爱。",
  "ntok": "Settlements.Settlement.name.castle_village_B6_2",
  "dtok": "Settlements.Settlement.text.castle_village_B6_2"
 },
 "castle_village_B7_1": {
  "sid": "castle_village_B7_1",
  "en": "Aster",
  "cn": "阿斯特",
  "culture": "battania",
  "desc_cn": "阿斯特坐落于乌卡利翁东北部山丘和格兰尼斯山间的浅谷中。当地人比起打仗更关注贸易，部落长老们鼓励大家种植葡萄以酿造出特别醇厚的葡萄酒。",
  "ntok": "Settlements.Settlement.name.castle_village_B7_1",
  "dtok": "Settlements.Settlement.text.castle_village_B7_1"
 },
 "castle_village_B7_2": {
  "sid": "castle_village_B7_2",
  "en": "Imlagh",
  "cn": "伊姆拉赫",
  "culture": "battania",
  "desc_cn": "伊姆拉赫位于乌卡利翁地块中部起伏的丘陵上。这座村庄特产用来酿造巴旦尼亚甜葡萄酒的白葡萄。",
  "ntok": "Settlements.Settlement.name.castle_village_B7_2",
  "dtok": "Settlements.Settlement.text.village_B2_4"
 },
 "castle_village_B8_1": {
  "sid": "castle_village_B8_1",
  "en": "Uthelaim",
  "cn": "乌瑟莱姆",
  "culture": "battania",
  "desc_cn": "乌瑟莱姆位于巴旦尼亚东部边境的一座山脊上，俯瞰着米尔河的一条支流。当地人是林农，他们采伐橡树、紫杉和松树，并将木材卖给建筑工和造船工。",
  "ntok": "Settlements.Settlement.name.castle_village_B8_1",
  "dtok": "Settlements.Settlement.text.castle_village_B8_1"
 },
 "castle_village_B8_2": {
  "sid": "castle_village_B8_2",
  "en": "Seordas",
  "cn": "肖尔达斯",
  "culture": "battania",
  "desc_cn": "肖尔达斯坐落于巴旦尼亚东部边境的低地，在乌卡利翁山崖脚下。附近的乌瑟莱姆要塞保护着该地暴露在外的农场，使其免受东边斯特吉亚强盗的袭击。",
  "ntok": "Settlements.Settlement.name.castle_village_B8_2",
  "dtok": "Settlements.Settlement.text.village_B4_5"
 },
 "castle_village_S1_1": {
  "sid": "castle_village_S1_1",
  "en": "Ustokol",
  "cn": "乌斯托科",
  "culture": "sturgia",
  "desc_cn": "乌斯托科坐落于瓦尔切格湾与比亚里海之间当风的卡恰尔半岛。当地人饲养的耐寒北方牛会在石缝间找小草吃，困难时期则补充一些海藻。",
  "ntok": "Settlements.Settlement.name.castle_village_S1_1",
  "dtok": "Settlements.Settlement.text.castle_village_S1_1"
 },
 "castle_village_S1_2": {
  "sid": "castle_village_S1_2",
  "en": "Zhemyan",
  "cn": "哲米扬",
  "culture": "sturgia",
  "desc_cn": "哲米扬位于卡恰尔半岛北岸。这里草木葱茏，是当地地主饲养马匹的绝佳地点。",
  "ntok": "Settlements.Settlement.name.castle_village_S1_2",
  "dtok": "Settlements.Settlement.text.village_S7_3"
 },
 "castle_village_S2_1": {
  "sid": "castle_village_S2_1",
  "en": "Mazhadan",
  "cn": "马扎丹",
  "culture": "sturgia",
  "desc_cn": "马扎丹靠近伽尔喀斯河的源头，在拉科尼斯湖的正西方。这片湿冷之地的村民们会在泥泞的山谷里种植亚麻。",
  "ntok": "Settlements.Settlement.name.castle_village_S2_1",
  "dtok": "Settlements.Settlement.text.castle_village_S2_1"
 },
 "castle_village_S2_2": {
  "sid": "castle_village_S2_2",
  "en": "Forin",
  "cn": "福林",
  "culture": "sturgia",
  "desc_cn": "福林坐落于伊卡拉荒原边加尔察河附近的黑麦和大麦田旁。这里的地主把林地变成了马匹的牧场。",
  "ntok": "Settlements.Settlement.name.castle_village_S2_2",
  "dtok": "Settlements.Settlement.text.village_S1_2"
 },
 "castle_village_S3_1": {
  "sid": "castle_village_S3_1",
  "en": "Nevyansk",
  "cn": "涅夫扬斯克",
  "culture": "sturgia",
  "desc_cn": "涅维扬斯克坐落于俯瞰瓦尔切格湾的一处平坦山角上。当地气候寒冷，但自山上流下的地表水带来了肥沃的土壤，村民们会种植黑麦、大麦等耐寒作物。",
  "ntok": "Settlements.Settlement.name.castle_village_S3_1",
  "dtok": "Settlements.Settlement.text.castle_village_S3_1"
 },
 "castle_village_S3_2": {
  "sid": "castle_village_S3_2",
  "en": "Dnin",
  "cn": "德宁",
  "culture": "sturgia",
  "desc_cn": "德宁位于俯瞰瓦尔切格湾狭窄处的牧草地上。马儿们在高地吃草，偶尔瞥一眼下面经过的长船和小渔船。",
  "ntok": "Settlements.Settlement.name.castle_village_S3_2",
  "dtok": "Settlements.Settlement.text.castle_village_S3_2"
 },
 "castle_village_S4_1": {
  "sid": "castle_village_S4_1",
  "en": "Kranirog",
  "cn": "克拉尼罗格",
  "culture": "sturgia",
  "desc_cn": "克拉尼罗格位于俯瞰加尔察河的开阔林谷内。此地的村民们是捕猎好手，猎取貂、狐狸和兔子的毛皮以供应南方的大量需求。",
  "ntok": "Settlements.Settlement.name.castle_village_S4_1",
  "dtok": "Settlements.Settlement.text.castle_village_S4_1"
 },
 "castle_village_S4_2": {
  "sid": "castle_village_S4_2",
  "en": "Ismilkorg",
  "cn": "伊斯米尔科格",
  "culture": "sturgia",
  "desc_cn": "伊斯米尔科格坐落于弥戎河的两条小支流——加尔察河与瓦斯特拉河间长满草的低地上。当地人大多既养牛又偷牛，并长期劫掠东边的帝国边境村庄和西边的巴旦尼亚人。",
  "ntok": "Settlements.Settlement.name.castle_village_S4_2",
  "dtok": "Settlements.Settlement.text.castle_village_S4_2"
 },
 "castle_village_S5_1": {
  "sid": "castle_village_S5_1",
  "en": "Ov",
  "cn": "奥夫",
  "culture": "sturgia",
  "desc_cn": "奥夫是伊卡拉荒原——拉科尼斯湖西北方的森林里一处较新的斯特吉亚殖民地。村民们最初定居于此是为了寻找毛皮，但猎物大多被驱赶到森林深处，如今他们在沼泽林地里种植亚麻。",
  "ntok": "Settlements.Settlement.name.castle_village_S5_1",
  "dtok": "Settlements.Settlement.text.castle_village_S5_1"
 },
 "castle_village_S5_2": {
  "sid": "castle_village_S5_2",
  "en": "Ferkh",
  "cn": "费赫",
  "culture": "sturgia",
  "desc_cn": "费赫位于伊卡拉荒原——拉科尼斯湖西北方森林的北部边缘处。它是冒险进入森林深处的商贩的据点，那些人需要面对严寒与狼群，以及寻求毛皮、喜怒无常的林中居民，还有北地的赏金猎人。",
  "ntok": "Settlements.Settlement.name.castle_village_S5_2",
  "dtok": "Settlements.Settlement.text.castle_village_S5_2"
 },
 "castle_village_S6_1": {
  "sid": "castle_village_S6_1",
  "en": "Takor",
  "cn": "塔科尔",
  "culture": "sturgia",
  "desc_cn": "塔科尔是一座养牛村，位于巴旦尼亚人称作“米纳德·里韦尔”，即“战争之山”的山口处。他们的帝国与斯特吉亚邻居们则称之为“弥那多耳”。这是连通荒凉北方与相对稳定的帝国疆土的主要通道之一，无论对商贸还是对劫掠来讲。",
  "ntok": "Settlements.Settlement.name.castle_village_S6_1",
  "dtok": "Settlements.Settlement.text.castle_village_S6_1"
 },
 "castle_village_S6_2": {
  "sid": "castle_village_S6_2",
  "en": "Dvorusta",
  "cn": "德沃鲁斯塔",
  "culture": "sturgia",
  "desc_cn": "德沃鲁斯塔是一座渔村，俯瞰着连接瓦尔切格湾和拉科尼斯湖的激流。村民们在黎明时分沿着悬崖一路走下去，捕捉跃过岩石的鲑鱼，还有海里的鲱鱼和鳕鱼。",
  "ntok": "Settlements.Settlement.name.castle_village_S6_2",
  "dtok": "Settlements.Settlement.text.village_S2_3"
 },
 "castle_village_S7_1": {
  "sid": "castle_village_S7_1",
  "en": "Urikskala",
  "cn": "乌里克斯卡拉",
  "culture": "sturgia",
  "desc_cn": "乌里克斯卡拉位于伊勒坦运输线上，那是一张由冰川湖构成的网络，拉科尼斯湖与塔奈西斯湖之间往来的长船可以在上面拖动与航行。村民们在浅水处捕获带刺的鲈鱼和螯虾，将其风干后卖给旅行者们。",
  "ntok": "Settlements.Settlement.name.castle_village_S7_1",
  "dtok": "Settlements.Settlement.text.castle_village_S7_1"
 },
 "castle_village_S7_2": {
  "sid": "castle_village_S7_2",
  "en": "Alov",
  "cn": "阿洛夫",
  "culture": "sturgia",
  "desc_cn": "阿洛夫位于名为伊勒坦运输线的冰湖网络边缘处。村民们在俯瞰湖泊的高地上种植黑麦与大麦，肥沃的黑土补偿了当地漫长的冬季和短暂的生长期。",
  "ntok": "Settlements.Settlement.name.castle_village_S7_2",
  "dtok": "Settlements.Settlement.text.village_S5_3"
 },
 "castle_village_S8_1": {
  "sid": "castle_village_S8_1",
  "en": "Vladiv",
  "cn": "弗拉基夫",
  "culture": "sturgia",
  "desc_cn": "弗拉基夫坐落于伊勒坦山脚下寒冷阴暗的林谷中。该地区的耐寒牛在冬季会挖开厚厚的积雪找草吃，以此熬到春天。",
  "ntok": "Settlements.Settlement.name.castle_village_S8_1",
  "dtok": "Settlements.Settlement.text.castle_village_S8_1"
 },
 "castle_village_S8_2": {
  "sid": "castle_village_S8_2",
  "en": "Glavstrom",
  "cn": "格拉夫斯特伦",
  "culture": "sturgia",
  "desc_cn": "格拉夫斯特伦坐落于东卡拉迪亚的一座峻峭险峰——伊勒坦山脚下，这座山得名自草原民族的一位神灵。这片荒野上有许多毛皮兽，如貂、狐狸、兔子等。",
  "ntok": "Settlements.Settlement.name.castle_village_S8_2",
  "dtok": "Settlements.Settlement.text.village_S4_2"
 },
 "village_B1_1": {
  "sid": "village_B1_1",
  "en": "Dalmengus",
  "cn": "达尔门格斯",
  "culture": "battania",
  "desc_cn": "达尔门格斯位于泰瓦尔湖——即乌卡利翁地块中央的暗湖之畔。这里的土地平坦肥沃且雨水丰沛，很适合种植小麦与大麦。",
  "ntok": "Settlements.Settlement.name.village_B1_1",
  "dtok": "Settlements.Settlement.text.village_B1_1"
 },
 "village_B1_2": {
  "sid": "village_B1_2",
  "en": "Ebereth",
  "cn": "埃贝雷斯",
  "culture": "battania",
  "desc_cn": "埃贝雷斯坐落于一处鞍状山脊上，一边是泰瓦尔湖，另一边则通往卡瓦尔谷的隘口。当地村民们种植葡萄来酿造巴旦尼亚地区甘甜的白葡萄酒。",
  "ntok": "Settlements.Settlement.name.village_B1_2",
  "dtok": "Settlements.Settlement.text.village_B1_2"
 },
 "village_B1_3": {
  "sid": "village_B1_3",
  "en": "Beglomuar",
  "cn": "贝格洛米艾",
  "culture": "battania",
  "desc_cn": "贝格洛米艾位于乌卡利翁地块南边峭壁的一处角落里。除了山上的矿床与沼泽的沼铁矿之外，这里就没什么吸引人的地方了。",
  "ntok": "Settlements.Settlement.name.village_B1_3",
  "dtok": "Settlements.Settlement.text.village_B1_3"
 },
 "village_B1_4": {
  "sid": "village_B1_4",
  "en": "Ath Cafal",
  "cn": "阿斯·卡瓦尔",
  "culture": "battania",
  "desc_cn": "阿斯·卡瓦尔靠近卡瓦尔谷——通往帝国领土的陡峭山谷之起始端。山上奔流而下的小溪中可以收集到优质的黏土。",
  "ntok": "Settlements.Settlement.name.village_B1_4",
  "dtok": "Settlements.Settlement.text.village_B1_4"
 },
 "village_B2_1": {
  "sid": "village_B2_1",
  "en": "Diantogmail",
  "cn": "迪安托格麦尔",
  "culture": "battania",
  "desc_cn": "迪安托格麦尔位于“林·泰瓦尔”，即“暗湖”之畔。有数种本地传说解释该地名字的由来——意为“白鼬之翔”，但没有任意两种版本的细节能对得上。这里的村民会从湖边收集黏土，供附近的工匠使用。",
  "ntok": "Settlements.Settlement.name.village_B2_1",
  "dtok": "Settlements.Settlement.text.village_B2_1"
 },
 "village_B2_2": {
  "sid": "village_B2_2",
  "en": "Glenlithrig",
  "cn": "格伦利斯里格",
  "culture": "battania",
  "desc_cn": "格伦利斯里格——一条湿滑的溪谷——位于乌卡利翁北边的高地上。当地村民主要都是林农，为附近的要塞城镇邓格拉尼斯和卡·班塞斯提供木材。",
  "ntok": "Settlements.Settlement.name.village_B2_2",
  "dtok": "Settlements.Settlement.text.village_B2_2"
 },
 "village_B2_3": {
  "sid": "village_B2_3",
  "en": "Morihig",
  "cn": "莫里希格",
  "culture": "battania",
  "desc_cn": "莫里希格坐落于乌卡利翁地块中部的一块盆地中。该地区以盛产小麦和大麦而闻名。",
  "ntok": "Settlements.Settlement.name.village_B2_3",
  "dtok": "Settlements.Settlement.text.village_B2_3"
 },
 "village_B3_1": {
  "sid": "village_B3_1",
  "en": "Bog Beth",
  "cn": "博格·贝斯",
  "culture": "battania",
  "desc_cn": "博格·贝斯坐落于乌卡利翁地块东部一座地势低矮的林谷中。村民们在阴暗的沼泽林地里用陷阱捕捉河狸、狐狸和其他毛皮兽。",
  "ntok": "Settlements.Settlement.name.village_B3_1",
  "dtok": "Settlements.Settlement.text.village_B3_1"
 },
 "village_B3_2": {
  "sid": "village_B3_2",
  "en": "Geunat Nal",
  "cn": "格纳特·纳尔",
  "culture": "battania",
  "desc_cn": "格纳特·纳尔是巴旦尼亚传说中决斗之地附近的一座村庄，据传纳尔在此留下了他的头颅。当地村民们以出色的护林人技能而闻名，他们帮助附近悬崖上的卡·班塞斯要塞抵御斯特吉亚人和其他掠夺者的攻击，保护着巴旦尼亚的腹地。",
  "ntok": "Settlements.Settlement.name.village_B3_2",
  "dtok": "Settlements.Settlement.text.village_B3_2"
 },
 "village_B3_3": {
  "sid": "village_B3_3",
  "en": "Tor Leiad",
  "cn": "托·莱阿德",
  "culture": "battania",
  "desc_cn": "托·莱阿德，满月之丘，坐落于巴旦尼亚北部的一座树木繁茂的小山丘下。当地村民们砍伐橡树、紫杉和山毛榉林。几百年来，巴旦尼亚人悉心照料着这些树木，保证木材一直足够采伐和贩卖。",
  "ntok": "Settlements.Settlement.name.village_B3_3",
  "dtok": "Settlements.Settlement.text.village_B3_3"
 },
 "village_B4_1": {
  "sid": "village_B4_1",
  "en": "Bryn Glas",
  "cn": "布林·格拉斯",
  "culture": "battania",
  "desc_cn": "布林·格拉斯坐落于乌卡利翁地块东边的悬崖上。村民们在山坡上种植葡萄，酿造出浓郁的深红色葡萄酒，深受瓦兰迪亚人和帝国人的喜爱。",
  "ntok": "Settlements.Settlement.name.village_B4_1",
  "dtok": "Settlements.Settlement.text.village_B4_1"
 },
 "village_B4_2": {
  "sid": "village_B4_2",
  "en": "Andurn",
  "cn": "安杜恩",
  "culture": "battania",
  "desc_cn": "安杜恩坐落于俯瞰“林·泰瓦尔”——即暗湖的山上裂口处。该地区的村民种植树木，采伐山毛榉、橡树和紫杉，再销往各城镇。",
  "ntok": "Settlements.Settlement.name.village_B4_2",
  "dtok": "Settlements.Settlement.text.village_B4_2"
 },
 "village_B4_3": {
  "sid": "village_B4_3",
  "en": "Mag Arba",
  "cn": "马格·阿尔巴",
  "culture": "battania",
  "desc_cn": "马格·阿尔巴坐落于俯瞰“林·泰瓦尔”——即暗湖的草场上。村民们在泥泞的山谷里种植亚麻。",
  "ntok": "Settlements.Settlement.name.village_B4_3",
  "dtok": "Settlements.Settlement.text.village_B4_3"
 },
 "village_B4_4": {
  "sid": "village_B4_4",
  "en": "Swenryn",
  "cn": "斯温林",
  "culture": "battania",
  "desc_cn": "斯温林俯瞰着岩石大瀑布，它阻挡了泰瓦尔湖的黑暗水域，形成乌卡利翁中央的湖泊。马儿在激流与瀑布之上的草地上觅食。",
  "ntok": "Settlements.Settlement.name.village_B4_4",
  "dtok": "Settlements.Settlement.text.village_B4_4"
 },
 "village_B5_1": {
  "sid": "village_B5_1",
  "en": "Durn",
  "cn": "杜恩",
  "culture": "battania",
  "desc_cn": "杜恩位于特朗河上游峡谷的下方。当水流平缓时，村民们从河边的水池和泥塘里刮取淤泥，沿着蜿蜒的小路把淤泥运到他们上方悬崖处的彭·坎诺克城。",
  "ntok": "Settlements.Settlement.name.village_B5_1",
  "dtok": "Settlements.Settlement.text.village_B5_1"
 },
 "village_B5_2": {
  "sid": "village_B5_2",
  "en": "Gainseth",
  "cn": "盖恩塞斯",
  "culture": "battania",
  "desc_cn": "盖恩塞斯位于乌卡利翁地块的东部边界、莱恩诺丘陵下一座阴暗的林谷中。当地村民们在湿地里收集泥土，卖给彭·坎诺克的陶工。",
  "ntok": "Settlements.Settlement.name.village_B5_2",
  "dtok": "Settlements.Settlement.text.village_B5_2"
 },
 "village_B5_3": {
  "sid": "village_B5_3",
  "en": "Fenon Etir",
  "cn": "韦农·埃蒂尔",
  "culture": "battania",
  "desc_cn": "韦农·埃蒂尔坐落于俯瞰特朗河支流——埃蒂尔河源头的一座露头山上。村庄下方，河水蜿蜒流淌于成堆的矿渣之间，这些矿渣是数百年来在附近山丘上开采富铁矿留下的残骸。",
  "ntok": "Settlements.Settlement.name.village_B5_3",
  "dtok": "Settlements.Settlement.text.village_B5_3"
 },
 "village_S1_1": {
  "sid": "village_S1_1",
  "en": "Rodobas",
  "cn": "罗多巴斯",
  "culture": "sturgia",
  "desc_cn": "罗多巴斯，“奥巴斯之屋”，得名自山上的一位亡故已久的斯特吉亚酋长。该村坐落在俯瞰伊卡拉荒原的山脊上，去山下黑暗的森林中猎取毛皮的猎人们将这里作为基地。",
  "ntok": "Settlements.Settlement.name.village_S1_1",
  "dtok": "Settlements.Settlement.text.village_S1_1"
 },
 "village_S1_3": {
  "sid": "village_S1_3",
  "en": "Kargrev",
  "cn": "卡格雷夫",
  "culture": "sturgia",
  "desc_cn": "卡格雷夫曾经叫作卡尔·格莱夫——巴旦尼亚酋长格莱夫的环形堡垒，但两代人之前此地被斯特吉亚人征服。它位于瓦尔切格湾沿岸，湾内海水相对平静，许多种鱼在繁殖期都会游到这里来，当地渔民很好地利用了这一点。",
  "ntok": "Settlements.Settlement.name.village_S1_3",
  "dtok": "Settlements.Settlement.text.village_S1_3"
 },
 "village_S2_1": {
  "sid": "village_S2_1",
  "en": "Safna",
  "cn": "萨夫纳",
  "culture": "sturgia",
  "desc_cn": "萨夫纳坐落于俯瞰激流的高耸山脊上，激流连接了拉科尼斯湖与狭窄的马佐波尔湾。村民们在靠近海崖的内陆种植小麦，那里的土地可以免受盐风的侵袭。",
  "ntok": "Settlements.Settlement.name.village_S2_1",
  "dtok": "Settlements.Settlement.text.village_S2_1"
 },
 "village_S2_2": {
  "sid": "village_S2_2",
  "en": "Marabrot",
  "cn": "马拉布罗特",
  "culture": "sturgia",
  "desc_cn": "马拉布罗特坐落于马佐波尔湾与比亚里海之间高耸的多岩山脊上。这片苦寒之地要是没有山上丰富的铁矿，估计就不会有人定居于此。",
  "ntok": "Settlements.Settlement.name.village_S2_2",
  "dtok": "Settlements.Settlement.text.village_S2_2"
 },
 "village_S3_1": {
  "sid": "village_S3_1",
  "en": "Chornobas",
  "cn": "乔诺巴斯",
  "culture": "sturgia",
  "desc_cn": "乔诺巴斯，或“黑树林”，坐落于由森林开辟出的一片土地上，俯瞰着弥戎河倾入拉科尼斯湖的大瀑布。村民们在瀑布旁水雾弥漫的田里种植黑麦与大麦。",
  "ntok": "Settlements.Settlement.name.village_S3_1",
  "dtok": "Settlements.Settlement.text.village_S3_1"
 },
 "village_S3_2": {
  "sid": "village_S3_2",
  "en": "Skorin",
  "cn": "斯科林",
  "culture": "sturgia",
  "desc_cn": "斯科林坐落于将佳托姆湾与拉科尼斯湖分割开的一个海角上。村民们在狭窄的海湾水域里捕捞淡水比目鱼，还在主湖区捕获梭鱼等更大的水产动物。",
  "ntok": "Settlements.Settlement.name.village_S3_2",
  "dtok": "Settlements.Settlement.text.village_S3_2"
 },
 "village_S4_1": {
  "sid": "village_S4_1",
  "en": "Borchovagorka",
  "cn": "博乔瓦戈卡",
  "culture": "sturgia",
  "desc_cn": "博乔瓦戈卡坐落于拉科尼斯湖陡峭北岸的一个小高处。这座村子以捕鱼为生，从湖水中捕捞鲈鱼、鲷鱼、鲑鱼，偶尔也捕捞大鲟鱼和梭鱼。",
  "ntok": "Settlements.Settlement.name.village_S4_1",
  "dtok": "Settlements.Settlement.text.village_S4_1"
 },
 "village_S4_3": {
  "sid": "village_S4_3",
  "en": "Omkany",
  "cn": "奥姆卡尼",
  "culture": "sturgia",
  "desc_cn": "奥姆卡尼坐落于拉科尼斯湖畔与冰雪覆盖的车尔特格山脉之间。该地区的村民们饲养猪，并用盐和蒜腌制猪肥肉，销往北地各处。",
  "ntok": "Settlements.Settlement.name.village_S4_3",
  "dtok": "Settlements.Settlement.text.village_S4_3"
 },
 "village_S4_4": {
  "sid": "village_S4_4",
  "en": "Yangutum",
  "cn": "扬古图姆",
  "culture": "sturgia",
  "desc_cn": "扬古图姆位于拉科尼斯湖北岸车尔特格山脉的一处角落。林务员们从山腰砍伐橡树、榆树和其他硬木。",
  "ntok": "Settlements.Settlement.name.village_S4_4",
  "dtok": "Settlements.Settlement.text.village_S4_4"
 },
 "village_S5_1": {
  "sid": "village_S5_1",
  "en": "Visibrot",
  "cn": "维西布罗特",
  "culture": "sturgia",
  "desc_cn": "维西布罗特是伊勒坦山缓坡上的一座养羊村，正好位于人称伊勒坦运输线的冰湖网络下。尽管该地区寒冷偏僻，但它作为拉科尼斯湖与塔奈西斯湖之间，帝国和草原之间贸易节点的重要性，仍使其拥有了相对稠密的人口。",
  "ntok": "Settlements.Settlement.name.village_S5_1",
  "dtok": "Settlements.Settlement.text.village_S5_1"
 },
 "village_S5_2": {
  "sid": "village_S5_2",
  "en": "Bukits",
  "cn": "布基茨",
  "culture": "sturgia",
  "desc_cn": "布基茨坐落于库赛特边境上伊勒坦山的东坡。这里的村民饲养一种高原牛，该品种可以抵御从山上吹来的刺骨寒风。",
  "ntok": "Settlements.Settlement.name.village_S5_2",
  "dtok": "Settlements.Settlement.text.village_S5_2"
 },
 "village_S6_1": {
  "sid": "village_S6_1",
  "en": "Kvol",
  "cn": "克沃尔",
  "culture": "sturgia",
  "desc_cn": "克沃尔的村民们会在车尔特格山脚下放牧一些好养活的小型牛。这些人当中有来自卡拉迪亚各地的难民与失意者的后代，他们在这寒气凛冽的北方森林中过着隐居避世的生活。",
  "ntok": "Settlements.Settlement.name.village_S6_1",
  "dtok": "Settlements.Settlement.text.village_S6_1"
 },
 "village_S6_2": {
  "sid": "village_S6_2",
  "en": "Radakmed",
  "cn": "拉达克梅德",
  "culture": "sturgia",
  "desc_cn": "拉达克梅德坐落于车尔特格山脉中的一片盆地。当地崎岖的荒野盛产狐狸、貂和兔子等毛皮动物。",
  "ntok": "Settlements.Settlement.name.village_S6_2",
  "dtok": "Settlements.Settlement.text.village_S6_2"
 },
 "village_S6_3": {
  "sid": "village_S6_3",
  "en": "Alebat",
  "cn": "阿莱巴特",
  "culture": "sturgia",
  "desc_cn": "阿莱巴特坐落于斯特吉亚东北部的森林深处。这片偏远之地长久以来都是北方各地逃离压迫、债务和世仇之人的避难所，当地口音受森林民族瓦尼人的影响非常大。",
  "ntok": "Settlements.Settlement.name.village_S6_3",
  "dtok": "Settlements.Settlement.text.village_S6_3"
 },
 "village_S7_1": {
  "sid": "village_S7_1",
  "en": "Korsyas",
  "cn": "科尔夏斯",
  "culture": "sturgia",
  "desc_cn": "科尔夏斯位于瓦尔切格湾最狭窄处旁。村民们出海向西，捕捞鳕鱼、鲑鱼和其他冒险进入海湾的冷水鱼。",
  "ntok": "Settlements.Settlement.name.village_S7_1",
  "dtok": "Settlements.Settlement.text.village_S7_1"
 },
 "village_S7_2": {
  "sid": "village_S7_2",
  "en": "Karbur",
  "cn": "卡布尔",
  "culture": "sturgia",
  "desc_cn": "卡布尔坐落于卡恰尔半岛的高原之上，多少受到了北边高耸山脊的一些庇护。当地村民们种植大麦和谷物。",
  "ntok": "Settlements.Settlement.name.village_S7_2",
  "dtok": "Settlements.Settlement.text.village_S7_2"
 }
}