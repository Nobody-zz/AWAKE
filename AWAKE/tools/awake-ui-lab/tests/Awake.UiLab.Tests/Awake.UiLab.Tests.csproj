<Project Sdk="Microsoft.NET.Sdk">
  <!--
    AWAKE UI Lab 的本地 E2 生命周期用例（离线，不启动 Bannerlord、不渲染 Gauntlet）。
    直接编译 Core 源码，避免本地测试对 NuGet / 程序集引用产生依赖。
    运行：dotnet run 加上 project 参数，指向 tools/awake-ui-lab/tests/Awake.UiLab.Tests。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Awake.UiLab.Tests</RootNamespace>
    <AssemblyName>Awake.UiLab.Tests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Awake.UiLab.Core\UiLabHostIdentity.cs" />
    <Compile Include="..\..\src\Awake.UiLab.Core\UiLabFixtureStateIds.cs" />
    <Compile Include="..\..\src\Awake.UiLab.Core\UiLabFixtureDto.cs" />
    <Compile Include="..\..\src\Awake.UiLab.Core\UiLabFixtureCatalog.cs" />
    <Compile Include="..\..\src\Awake.UiLab.Core\UiLabHostPlatform.cs" />
    <Compile Include="..\..\src\Awake.UiLab.Core\UiLabHostSession.cs" />
    <Compile Include="..\..\src\Awake.UiLab.Core\UiLabPrefabAudit.cs" />
    <Compile Include="..\..\src\Awake.UiLab.Core\UiLabFixtureRunner.cs" />
    <Compile Include="FakeUiLabPlatform.cs" />
    <Compile Include="UiLabLifecycleFixtures.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
