<Project Sdk="Microsoft.NET.Sdk">
  <!-- 语义臂「挂载器」验台（2026-09-17）。
       问的问题只有一个：**生产里那根线接上以后，语义臂到底有没有真的开始工作**。

       与另两个验台的分工：
         · `worldbook-runtime-smoke` = 门禁，不加载模型，只量字面臂；
         · `worldbook-rag-merge`    = 量"融合比字面多拿几条"（直接把索引手工挂上去）；
         · 本验台               = 量"**由生产挂载器 `AwakeSemanticArmBootstrap` 去挂**"这条链，
           包括世界书先到/host 后到、换战役要重新入库、失败静默回落、同会话不重复入库。

       形态是**零替身**：宿主用框架自己的 `FrameworkHost.CreateDefaultHost`，会话用框架自己的
       `SessionCoordinator`，RAG 后端与嵌入器都是真件（真 SQLite + 真 ONNX）。
       唯一"片"出去的是 `AwakeRuntime` 的 host 解析（游戏内那套要走 TaleWorlds 定位器），
       见 `SemanticArmStubs.cs`：它与真件**同源到兼容构造函数**。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Awake.SemanticArmBootstrapSmoke</RootNamespace>
    <AssemblyName>semantic-arm-bootstrap-smoke</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1701;NU1702</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\framework\MarcusAwakeStorage\MarcusAwakeStorage.csproj" />
    <ProjectReference Include="..\..\framework\MarcusAwakeFramework\MarcusAwakeFramework.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Newtonsoft.Json" HintPath="D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord\bin\Win64_Shipping_Client\Newtonsoft.Json.dll" />
  </ItemGroup>
  <ItemGroup>
    <!-- 游戏侧真代码：与 `worldbook-rag-merge` 取自同一批（平行实现必须同源）。
         新增文件必须**手补**到这个清单里，否则只在跑起来的那一步炸 CS0246。 -->
    <Compile Include="..\..\src\WorldKnowledgeModels.cs" Link="src\WorldKnowledgeModels.cs" />
    <Compile Include="..\..\src\WorldKnowledgeSemantic.cs" Link="src\WorldKnowledgeSemantic.cs" />
    <Compile Include="..\..\src\WorldbookIdentityEvaluator.cs" Link="src\WorldbookIdentityEvaluator.cs" />
    <Compile Include="..\..\src\WorldbookIdentityCapabilityRules.cs" Link="src\WorldbookIdentityCapabilityRules.cs" />
    <Compile Include="..\..\src\WorldbookEntityId.cs" Link="src\WorldbookEntityId.cs" />
    <Compile Include="..\..\src\WorldbookPackageIntegrity.cs" Link="src\WorldbookPackageIntegrity.cs" />
    <Compile Include="..\..\src\WorldKnowledgeLoader.cs" Link="src\WorldKnowledgeLoader.cs" />
    <Compile Include="..\..\src\WorldKnowledgeQueryService.cs" Link="src\WorldKnowledgeQueryService.cs" />
    <Compile Include="..\..\src\WorldKnowledgeProjectionService.cs" Link="src\WorldKnowledgeProjectionService.cs" />
    <Compile Include="..\..\src\WorldbookPackageRegistry.cs" Link="src\WorldbookPackageRegistry.cs" />
    <Compile Include="..\..\src\PersonaRootLocator.cs" Link="src\PersonaRootLocator.cs" />
    <Compile Include="..\..\src\WorldEventLedger.cs" Link="src\WorldEventLedger.cs" />
    <Compile Include="..\..\src\WorldEventContracts.cs" Link="src\WorldEventContracts.cs" />
    <Compile Include="..\..\src\WeeklyReportService.cs" Link="src\WeeklyReportService.cs" />
    <Compile Include="..\..\src\WorldFactCapture.cs" Link="src\WorldFactCapture.cs" />
    <Compile Include="..\..\src\WorldFactJournal.cs" Link="src\WorldFactJournal.cs" />
    <Compile Include="..\..\src\WorldFactQuery.cs" Link="src\WorldFactQuery.cs" />
    <Compile Include="..\..\src\AwakeEventModels.cs" Link="src\AwakeEventModels.cs" />
    <Compile Include="..\..\src\AwakeEventEngineCore.cs" Link="src\AwakeEventEngineCore.cs" />
    <Compile Include="..\..\src\AwakeEventDataLoader.cs" Link="src\AwakeEventDataLoader.cs" />
    <Compile Include="..\..\src\AwakeEventCandidateEvaluator.cs" Link="src\AwakeEventCandidateEvaluator.cs" />
    <!-- ★ 本验台要证的那两件（其余验台没有）：语义适配器 + **生产挂载器** -->
    <Compile Include="..\..\src\AwakeWorldKnowledgeSemanticIndex.cs" Link="src\AwakeWorldKnowledgeSemanticIndex.cs" />
    <Compile Include="..\..\src\AwakeSemanticArmBootstrap.cs" Link="src\AwakeSemanticArmBootstrap.cs" />
