{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"awake.worldbook.profile-registry.v1",
  "type":"object",
  "additionalProperties":false,
  "required":["registry_id","registry_version","profiles"],
  "properties": {
    "registry_id":{"const":"awake.profile.registry"},
    "registry_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "profiles":{"type":"array","minItems":1,"uniqueItems":true,"items":{
      "type":"object","additionalProperties":false,"required":["id","display"],
      "properties":{
        "id":{"type":"string","pattern":"^profile\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
        "display":{"type":"object","minProperties":1,"additionalProperties":{"type":"string","minLength":1}},
        "inherits":{"type":"string","pattern":"^profile\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"}
      }
    }}
  }
}