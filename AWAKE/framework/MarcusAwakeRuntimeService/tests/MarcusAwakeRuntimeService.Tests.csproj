<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MarcusAwakeRuntimeService.Tests</RootNamespace>
    <AssemblyName>MarcusAwakeRuntimeService.Tests</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU1702</NoWarn>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseAppHost>true</UseAppHost>
    <OutputPath>$(MSBuildThisFileDirectory)_build_out\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="FirstByteGateStream.cs" />
    <Compile Include="P3DA0Harness.cs" />
    <Compile Include="P3DA1Harness.cs" />
    <Compile Include="P3DA2Harness.cs" />
    <Compile Include="ProviderStreamModelsTests.cs" />
    <Compile Include="RagClientTests.cs" />
    <Compile Include="MediaClientTests.cs" />
    <Compile Include="RuntimeProviderOutcomeLedgerTests.cs" />
    <Compile Include="RuntimeServiceLogTests.cs" />
    <ProjectReference Include="..\..\MarcusAwakeTransport\MarcusAwakeTransport.csproj" />
    <ProjectReference Include="..\..\MarcusAwakeFramework\MarcusAwakeFramework.csproj" />
    <ProjectReference Include="..\MarcusAwakeRuntimeService.csproj" />
  </ItemGroup>
</Project>
