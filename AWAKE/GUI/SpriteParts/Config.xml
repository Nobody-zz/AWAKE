<?xml version="1.0" encoding="utf-8"?>
<SpriteCategories>
  <!-- AWAKE UI 自有贴图。分类名必须以 ui_ 开头（官方硬要求）。
       参考 TaleWorlds《Generating and Loading UI Sprite Sheets》。
       <AlwaysLoad/> 必需：否则该分类不会加载。 -->
  <SpriteCategory Name="ui_awake_frame">
    <!-- 面板底 / 框 / 凹槽 -->
    <AlwaysLoad/>
    <SpriteSheetSize Width="2048" Height="2048"/>
  </SpriteCategory>
  <SpriteCategory Name="ui_awake_ornament">
    <!-- 栏头 / 分隔 / 角饰 -->
    <AlwaysLoad/>
    <SpriteSheetSize Width="2048" Height="2048"/>
  </SpriteCategory>
  <SpriteCategory Name="ui_awake_button">
    <!-- 按钮（逐状态） -->
    <AlwaysLoad/>
    <SpriteSheetSize Width="2048" Height="2048"/>
  </SpriteCategory>
</SpriteCategories>
