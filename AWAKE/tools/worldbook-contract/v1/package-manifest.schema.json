{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "awake.worldbook.package.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "version", "kind", "displayName", "worldId", "entrypoints", "hashes"],
  "properties": {
    "schemaVersion": { "const": "awake.worldbook.v2" },
    "packageId": { "$ref": "common.schema.json#/$defs/package_id" },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "kind": { "enum": ["universe", "extension", "adapter"] },
    "displayName": { "$ref": "common.schema.json#/$defs/localized" },
    "worldId": { "$ref": "common.schema.json#/$defs/stable_id" },
    "targetWorldIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/stable_id" }, "uniqueItems": true },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packageId", "versionRange"],
        "properties": {
          "packageId": { "$ref": "common.schema.json#/$defs/package_id" },
          "versionRange": { "type": "string", "minLength": 1 },
          "packageHash": { "$ref": "common.schema.json#/$defs/hash" }
        }
      },
      "uniqueItems": true
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "index"],
      "properties": {
        "runtime": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\:*?\"<>|]+$" },
        "index": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)[^\\\\:*?\"<>|]+$" },
        "adapter": { "type": ["string", "null"] }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestHash", "contentHash", "packageHash"],
      "properties": {
        "manifestHash": { "$ref": "common.schema.json#/$defs/hash" },
        "contentHash": { "$ref": "common.schema.json#/$defs/hash" },
        "packageHash": { "$ref": "common.schema.json#/$defs/hash" }
      }
    },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  }
}
