{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"awake.worldbook.assistance.result.v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","request_hash","source_document_hash","suggestions"],
  "properties":{
    "schema_version":{"const":"assistance.result.v1"},
    "request_hash":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"},
    "source_document_hash":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"},
    "suggestions":{"type":"array","maxItems":64,"items":{"type":"object","additionalProperties":false,"required":["id","kind","severity","confidence","title","reason","review_only"],"properties":{"id":{"type":"string","minLength":1,"maxLength":128},"kind":{"type":"string","minLength":1,"maxLength":64},"severity":{"type":"string","minLength":1,"maxLength":32},"confidence":{"type":"number","minimum":0,"maximum":1},"title":{"type":"string","minLength":1,"maxLength":512},"reason":{"type":"string","minLength":1,"maxLength":4000},"candidate_text":{"type":"string","maxLength":12000},"patch":{"$ref":"knowledge-patch.v1.schema.json"},"review_only":{"const":true}}}}
  }
}