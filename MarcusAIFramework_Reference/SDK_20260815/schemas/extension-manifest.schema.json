{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maf.sdk.extension-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["extensionId", "displayNameTextId", "version", "publicApi", "bannerlordApis", "requestedPermissions"],
  "properties": {
    "extensionId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,160}$" },
    "displayNameTextId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,160}$" },
    "version": { "type": "string", "maxLength": 32 },
    "publicApi": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "bannerlordApis": { "type": "array", "minItems": 1, "items": { "enum": ["1.4.8", "1.3.15"] } },
    "requestedPermissions": { "type": "array", "maxItems": 128, "items": { "type": "string", "maxLength": 192 } },
    "routeIds": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,160}$" } },
    "requiredCapabilities": { "type": "array", "items": { "type": "string", "pattern": "^capability://" } },
    "optionalCapabilities": { "type": "array", "items": { "type": "string", "pattern": "^capability://" } }
  }
}
