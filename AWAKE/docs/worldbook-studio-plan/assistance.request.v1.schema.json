{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "awake.worldbook.assistance.request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "analysis",
    "focus",
    "request_hash",
    "source_document_hash",
    "saved_revision",
    "document",
    "registry_summary",
    "output_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "assistance.request.v1"
    },
    "provider_id": {
      "enum": [
        "local",
        "cloud"
      ]
    },
    "analysis": {
      "enum": [
        "permissions",
        "consistency",
        "metadata",
        "prose"
      ]
    },
    "focus": {
      "enum": [
        "general",
        "completion",
        "fact_correction",
        "knowledge_permissions",
        "hierarchy",
        "expression_level",
        "metadata",
        "world_style",
        "npc_voice",
        "domain_style"
      ]
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "source_document_hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "saved_revision": {
      "type": "integer",
      "minimum": 1
    },
    "output_contract": {
      "const": "assistance.result.v1"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "assertions"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string"
        },
        "title": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 12000
          }
        },
        "status": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "universe": {
          "type": "string"
        },
        "era": {
          "type": "string"
        },
        "content_tier": {
          "type": "string"
        },
        "summary": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 12000
          }
        },
        "entity_ids": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "string"
          }
        },
        "aliases": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "string"
          }
        },
        "assertions": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "kind": {
                "type": "string"
              },
              "text": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 12000
                }
              },
              "expressions": {
                "type": "array",
                "maxItems": 1024,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "revision": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "layer": {
                      "type": "string"
                    },
                    "text": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "maxLength": 12000
                      }
                    },
                    "grants": {
                      "type": "array",
                      "maxItems": 512
                    },
                    "denies": {
                      "type": "array",
                      "maxItems": 512
                    },
                    "fallback_referral_ids": {
                      "type": "array",
                      "maxItems": 128,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "subdomain": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "related_domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "enum": [
              "politics",
              "economy",
              "culture",
              "war",
              "geography"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "registry_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "string"
          }
        },
        "referrals": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
