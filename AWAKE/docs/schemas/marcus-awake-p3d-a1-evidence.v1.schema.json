{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "marcus-awake/p3d-a1-evidence.v1",
  "title": "Marcus-Awake P3D-A1 unary Provider evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_revision",
    "batch_id",
    "runner",
    "service",
    "fake_http",
    "artifacts",
    "cases",
    "redaction",
    "flags"
  ],
  "properties": {
    "schema": { "const": "marcus-awake.p3d-a1-evidence.v1" },
    "plan_revision": { "const": 7 },
    "batch_id": { "const": "MARCUS-AWAKE-P3D-A1-UNARY-PROVIDER-BRIDGE-20260828" },
    "captured_at_utc": { "type": "string", "minLength": 1 },
    "runner": { "$ref": "#/definitions/runner" },
    "service": { "$ref": "#/definitions/service" },
    "fake_http": { "$ref": "#/definitions/fake_http" },
    "artifacts": { "$ref": "#/definitions/artifacts" },
    "cases": {
      "type": "array",
      "minItems": 23,
      "maxItems": 23,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/case" }
    },
    "redaction": { "$ref": "#/definitions/redaction" },
    "flags": { "$ref": "#/definitions/flags" }
  },
  "definitions": {
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments", "exit_code", "working_directory"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "exit_code": { "const": 0 },
        "working_directory": { "type": "string", "minLength": 1 }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments", "pid", "private_pipe_name", "exit_code", "process_role"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "arguments": { "type": "array", "items": { "type": "string" } },
        "pid": { "type": "integer", "minimum": 1 },
        "private_pipe_name": { "type": "string", "minLength": 1 },
        "exit_code": { "const": 0 },
        "process_role": { "const": "service_child" }
      }
    },
    "fake_http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bind", "capture_path", "request_count", "harness_request_count", "service_request_count", "observations"],
      "properties": {
        "bind": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/$" },
        "capture_path": { "type": "string", "minLength": 1 },
        "request_count": { "type": "integer", "minimum": 0 },
        "harness_request_count": { "const": 0 },
        "service_request_count": { "type": "integer", "minimum": 0 },
        "observations": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "method", "path"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "method": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "process_role",
        "runner_executable",
        "runner_arguments",
        "service_executable",
        "service_arguments",
        "service_pid",
        "private_pipe_name",
        "fake_http_bind",
        "fake_http_capture_path",
        "provider_http_request_count",
        "request_message_type",
        "response_message_type",
        "provider_call_count",
        "http_request_count",
        "ledger_state_before",
        "ledger_state_after",
        "cancel_observed",
        "write_outcome",
        "replay_outcome",
        "observation_hash"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^P3D-A1-(S|C)[0-9]{2}-.+" },
        "status": { "const": "pass" },
        "process_role": { "const": "service_child" },
        "runner_executable": { "type": "string", "minLength": 1 },
        "runner_arguments": { "type": "array", "items": { "type": "string" } },
        "service_executable": { "type": "string", "minLength": 1 },
        "service_arguments": { "type": "array", "items": { "type": "string" } },
        "service_pid": { "type": "integer", "minimum": 1 },
        "private_pipe_name": { "type": "string", "minLength": 1 },
        "fake_http_bind": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/$" },
        "fake_http_capture_path": { "type": "string", "minLength": 1 },
        "provider_http_request_count": { "type": "integer", "minimum": 0 },
        "request_message_type": { "type": "string", "minLength": 1 },
        "response_message_type": { "type": "string", "minLength": 1 },
        "provider_call_count": { "type": "integer", "minimum": 0 },
        "http_request_count": { "type": "integer", "minimum": 0 },
        "ledger_state_before": { "type": "string", "minLength": 1 },
        "ledger_state_after": { "type": "string", "minLength": 1 },
        "cancel_observed": { "type": "boolean" },
        "write_outcome": { "type": "string", "minLength": 1 },
        "replay_outcome": { "type": "string", "minLength": 1 },
        "observation_hash": { "$ref": "#/definitions/sha256" }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport_sha256", "framework_sha256", "provider_sha256", "service_sha256", "harness_sha256"],
      "properties": {
        "transport_sha256": { "$ref": "#/definitions/sha256" },
        "framework_sha256": { "$ref": "#/definitions/sha256" },
        "provider_sha256": { "$ref": "#/definitions/sha256" },
        "service_sha256": { "$ref": "#/definitions/sha256" },
        "harness_sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scan_paths", "secret_found", "forbidden_match_count", "passed"],
      "properties": {
        "scan_paths": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stdout", "stderr", "fake_capture", "evidence"],
          "properties": {
            "stdout": { "type": "string", "minLength": 1 },
            "stderr": { "type": "string", "minLength": 1 },
            "fake_capture": { "type": "string", "minLength": 1 },
            "evidence": { "type": "string", "minLength": 1 }
          }
        },
        "secret_found": { "const": false },
        "forbidden_match_count": { "const": 0 },
        "passed": { "const": true }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_network", "real_cloud_provider", "bannerlord_started", "game_directory_synced"],
      "properties": {
        "external_network": { "const": false },
        "real_cloud_provider": { "const": false },
        "bannerlord_started": { "const": false },
        "game_directory_synced": { "const": false }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
