{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "awake.customer.package-verification.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "build_id",
    "source_manifest_hashes",
    "package_tree_sha256",
    "zip_content_sha256",
    "zip_file_sha256",
    "extracted_tree_sha256",
    "checks",
    "evidence_status"
  ],
  "properties": {
    "schema_version": { "const": "awake.customer.package-verification.v1" },
    "build_id": { "type": "string", "pattern": "^awake-customer-[A-Za-z0-9._-]+$" },
    "source_manifest_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ui_workstation", "worldbook_studio", "persona_workbench"],
      "properties": {
        "ui_workstation": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "worldbook_studio": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "persona_workbench": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "package_tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "zip_content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "zip_file_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "extracted_tree_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_bound", "child_packages", "root_tree", "zip", "extracted"],
      "properties": {
        "source_bound": { "type": "boolean" },
        "child_packages": { "type": "boolean" },
        "root_tree": { "type": "boolean" },
        "zip": { "type": "boolean" },
        "extracted": { "type": "boolean" }
      }
    },
    "evidence_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offline", "local_worker"],
      "properties": {
        "offline": { "enum": ["not_run", "not_run_by_package_builder", "passed", "failed", "unverified"] },
        "local_worker": { "enum": ["not_run", "not_run_by_package_builder", "passed", "failed", "unverified"] }
      }
    }
  }
}
