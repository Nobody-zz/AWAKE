{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "awake.persona.fixture-report.v1",
  "title": "AWAKE Persona fixture report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureId", "commandLine", "normalizedCwd", "inputHashes", "outputHashes", "handoff", "exitCode", "status", "assertions", "observedErrors", "cleanup"],
  "properties": {
    "schemaVersion": { "const": "awake.persona.fixture-report.v1" },
    "fixtureId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "commandLine": { "type": "string", "minLength": 1 },
    "normalizedCwd": { "type": "string", "minLength": 1 },
    "inputHashes": {
      "type": "array",
      "items": { "$ref": "#/$defs/hashEntry" }
    },
    "outputHashes": {
      "type": "array",
      "items": { "$ref": "#/$defs/hashEntry" }
    },
    "handoff": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceRevision", "authoringRevision", "selectionRevision", "sourceSha256", "sourceRegistrySha256", "registrySha256", "authoringSha256", "mappingReportSha256", "exportSha256", "definitionSha256", "workbenchApprovalEvidenceId", "awakeApprovalEvidenceId"],
          "properties": {
            "sourceRevision": { "type": "integer", "minimum": 1 },
            "authoringRevision": { "type": "integer", "minimum": 1 },
            "selectionRevision": { "type": "integer", "minimum": 1 },
            "sourceSha256": { "$ref": "#/$defs/sha256" },
            "sourceRegistrySha256": { "$ref": "#/$defs/sha256" },
            "registrySha256": { "$ref": "#/$defs/sha256" },
            "authoringSha256": { "$ref": "#/$defs/sha256" },
            "mappingReportSha256": { "$ref": "#/$defs/sha256" },
            "exportSha256": { "$ref": "#/$defs/sha256" },
            "definitionSha256": { "$ref": "#/$defs/sha256" },
            "workbenchApprovalEvidenceId": { "$ref": "#/$defs/stableId" },
            "awakeApprovalEvidenceId": { "$ref": "#/$defs/stableId" }
          }
        }
      ]
    },
    "exitCode": { "enum": [0, 10, 20, 30, 40] },
    "status": { "enum": ["pass", "reject", "blocked", "not_attempted", "error"] },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assertion" }
    },
    "observedErrors": {
      "type": "array",
      "items": { "$ref": "#/$defs/adapterError" }
    },
    "cleanup": { "$ref": "#/$defs/cleanup" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-F0-9]{64}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
    },
    "hashEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "sha256": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "passed", "detail"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "passed": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "adapterError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "errorId", "code", "stage", "artifactId", "path", "detail", "retryable"],
      "properties": {
        "schemaVersion": { "const": "awake.persona.adapter-error.v1" },
        "errorId": { "$ref": "#/$defs/stableId" },
        "code": { "type": "string", "pattern": "^persona\\.[a-z0-9_.-]+$" },
        "stage": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
        "artifactId": { "$ref": "#/$defs/stableId" },
        "path": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "paths", "errors"],
      "properties": {
        "status": { "enum": ["pass", "error", "not_attempted"] },
        "paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "errors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
