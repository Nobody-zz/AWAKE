 "lac-lake": {
  "en_terms": [
   "Lakonis Lake"
  ],
  "zh_terms": [
   "拉科尼斯湖",
   "弥戎河",
   "喀拉卡兹河"
  ],
  "extra_en": [],
  "hits": {
   "settlement_desc": [],
   "loc_cns": [
    {
     "term": "拉科尼斯湖",
     "stringId": "Settlements.Settlement.text.castle_village_EN2_1",
     "text": "罗卡那位于拉科尼斯湖的东岸。拉科尼斯湖缓和了北方冬季的寒冷，为种植桑树、产蚕丝提供了条件。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "拉科尼斯湖",
     "stringId": "Settlements.Settlement.text.castle_village_EN5_1",
     "text": "阿特里翁坐落于涅维斯谷中，冰冷的缓流由此汇入拉科尼斯湖。这里的土地适合种植桑树，用于生产蚕丝。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "拉科尼斯湖",
     "stringId": "Settlements.Settlement.text.castle_village_EN7_1",
     "text": "厄毗诺萨位于帝国的极北之地，刚好在伊勒坦运输线的冰川湖南岸，拉科尼斯湖与塔奈西斯湖之间的船只川流不息。该地区人口相对稀少，但葱郁的草甸上放养着大群的牛。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "拉科尼斯湖",
     "stringId": "Settlements.Settlement.text.castle_village_EN7_2",
     "text": "庞斯是帝国最北端的定居点之一。该地因位于伊勒坦运输线的“交叉口”而得名，一系列冰川湖构成的网络令船只得以通行于拉科尼斯湖与塔奈西斯湖之间。当地人在附近的山丘上开",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "拉科尼斯湖",
     "stringId": "Settlements.Settlement.text.castle_village_EN9_1",
     "text": "墨卡罗维亚俯瞰着伽尔喀斯大瀑布，这座瀑布由一系列湍急的水流构成，并最终同弥戎河一起汇入拉科尼斯湖。村庄座落于一道峭壁之上，以期在这边疆之地免受强盗匪帮的侵扰。飞",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "弥戎河",
     "stringId": "Settlements.Settlement.text.castle_village_B5_1",
     "text": "雷姆托伊尔位于乌卡利翁高原东部悬崖的裂隙下，靠近巴旦尼亚人称为“米尔”的弥戎河的源头。这里是巴旦尼亚土壤最肥沃的地方，小麦收成很好。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "弥戎河",
     "stringId": "Settlements.Settlement.text.castle_village_EN9_1",
     "text": "墨卡罗维亚俯瞰着伽尔喀斯大瀑布，这座瀑布由一系列湍急的水流构成，并最终同弥戎河一起汇入拉科尼斯湖。村庄座落于一道峭壁之上，以期在这边疆之地免受强盗匪帮的侵扰。飞",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "弥戎河",
     "stringId": "Settlements.Settlement.text.castle_village_EN9_2",
     "text": "阿加尔蒙紧挨着两条细小而湍急的北方河流——伽尔喀斯河和弥戎河的汇流处。这座多林村庄的居民世代与相邻的斯特吉亚人通婚，原本往来颇为友好，然而战争的爆发令双方关系趋",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "弥戎河",
     "stringId": "Settlements.Settlement.text.castle_village_EW8_1",
     "text": "革耳塞戈斯坐落于分割库耳西翁峭壁与德律亚山脉的弥戎河谷中。村民们在俯瞰村庄的一个山嘴上开了矿，提炼出银与其他贵金属。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "弥戎河",
     "stringId": "Settlements.Settlement.text.castle_village_S4_2",
     "text": "伊斯米尔科格坐落于弥戎河的两条小支流——加尔察河与瓦斯特拉河间长满草的低地上。当地人大多既养牛又偷牛，并长期劫掠东边的帝国边境村庄和西边的巴旦尼亚人。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    }
   ],
   "loc_en_exact": []
  }
 },
