 "der-furs": {
  "en_terms": [
   "Deriat"
  ],
  "zh_terms": [
   "德里亚特",
   "毛皮",
   "海豹油"
  ],
  "extra_en": [],
  "hits": {
   "settlement_desc": [
    {
     "term": "Deriat",
     "settlement": "castle_village_V6_2",
     "snip": "{=Settlements.Settlement.text.castle_village_V6_2}Deriat sits between the Bay of Varcheg and the ridges of the Ebor peni"
    }
   ],
   "loc_cns": [
    {
     "term": "德里亚特",
     "stringId": "Settlements.Settlement.text.castle_village_V6_2",
     "text": "德里亚特位于瓦尔切格湾与埃博半岛的山脊之间。当地村民会在山上捕获河狸与水貂，有时会在海湾水域捉海豹。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "毛皮",
     "stringId": "Settlements.Settlement.text.castle_village_S4_1",
     "text": "克拉尼罗格位于俯瞰加尔察河的开阔林谷内。此地的村民们是捕猎好手，猎取貂、狐狸和兔子的毛皮以供应南方的大量需求。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "毛皮",
     "stringId": "Settlements.Settlement.text.castle_village_S5_1",
     "text": "奥夫是伊卡拉荒原——拉科尼斯湖西北方的森林里一处较新的斯特吉亚殖民地。村民们最初定居于此是为了寻找毛皮，但猎物大多被驱赶到森林深处，如今他们在沼泽林地里种植亚麻",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "毛皮",
     "stringId": "Settlements.Settlement.text.castle_village_S5_2",
     "text": "费赫位于伊卡拉荒原——拉科尼斯湖西北方森林的北部边缘处。它是冒险进入森林深处的商贩的据点，那些人需要面对严寒与狼群，以及寻求毛皮、喜怒无常的林中居民，还有北地的",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "毛皮",
     "stringId": "Settlements.Settlement.text.village_B3_1",
     "text": "博格·贝斯坐落于乌卡利翁地块东部一座地势低矮的林谷中。村民们在阴暗的沼泽林地里用陷阱捕捉河狸、狐狸和其他毛皮兽。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "毛皮",
     "stringId": "Settlements.Settlement.text.village_K1_3",
     "text": "库鲁卢克位于喀拉卡孜河的支流——札罕河畔。尽管这片谷地几乎终年积雪，但草原小马仍靠吃春草和在冬天挖雪找食物的方式顽强生存，厚毛皮帮助它们抵御呼啸的刺骨寒风。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    }
   ],
   "loc_en_exact": [
    {
     "term": "Deriat",
     "stringId": "Settlements.Settlement.name.castle_village_V6_2",
     "text": "Deriat"
    }
   ]
  }
 },
