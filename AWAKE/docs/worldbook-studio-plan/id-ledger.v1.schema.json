{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"awake.worldbook.id-ledger.v1",
  "type":"object",
  "additionalProperties":false,
  "required":["id","id_kind","revision","first_revision","last_state","event_id","record_hash"],
  "properties": {
    "id":{"type":"string","pattern":"^[a-z]+\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "id_kind":{"enum":["document","assertion","expression","entity","profile","referral","source","redirect","event","author"]},
    "revision":{"type":"integer","minimum":1},
    "first_revision":{"type":"integer","minimum":1},
    "last_state":{"enum":["active","redirected","merged","split","tombstoned"]},
    "event_id":{"type":"string","pattern":"^event\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "record_hash":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"}
  }
}