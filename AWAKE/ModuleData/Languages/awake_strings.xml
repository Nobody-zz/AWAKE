    <string id="awake.mcm.provider_api_key.content" text="Open input" />
    <string id="awake.mcm.provider_api_key.hint" text="The input stays visible so you can verify it. The key is stored only in protected local storage and never enters MCM, saves, or logs." />
    <string id="awake.mcm.provider_apply.name" text="Save and apply configuration" />
    <string id="awake.mcm.provider_apply.content" text="Save and apply" />
    <string id="awake.mcm.provider_apply.hint" text="Apply the service type, address, and model to all AWAKE AI routes." />
