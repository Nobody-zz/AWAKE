    "ragShortTexts":  [
                          "卡利奥克是萨哥特附近村庄，位于纳尔谷。"
                      ],
    "semanticPrototypes":  [

                           ],
    "kind":  "background",
    "scope":  "npc",
    "persistence":  "persistent",
