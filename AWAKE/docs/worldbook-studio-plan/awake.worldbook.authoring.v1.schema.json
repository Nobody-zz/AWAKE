            "summary",
            "detail",
            "secret"
          ]
        },
        "culture_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^entity\\.culture\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "kingdom_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^entity\\.kingdom\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "settlement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^entity\\.settlement\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "role_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^entity\\.role\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "clan_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^entity\\.clan\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "is_female": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "is_clan_leader": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "min_age": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_age": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "min_management": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "min_steward": {
          "type": [
