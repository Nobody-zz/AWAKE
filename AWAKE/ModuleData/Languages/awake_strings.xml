    <string id="awake.mcm.ai_status.name" text="AI Link Status" />
    <string id="awake.mcm.ai_status.hint" text="Read-only summary of the embedded Runtime, Provider, routes, campaign session, and cloud export state. Configure all player-facing AI settings in this group." />
    <string id="awake.mcm.cloud_export.name" text="Enable Cloud Export" />
    <string id="awake.mcm.cloud_export.hint" text="Enabled by default. Local Ollama and other local links still work when this is off; cloud dialogue still requires framework route permission." />
    <string id="awake.mcm.export_player_state.name" text="Allow Player State Export" />
    <string id="awake.mcm.export_player_state.hint" text="Allows player, hero and relationship state to be exported as player_state in NPC dialogue. Enabled by default." />
    <string id="awake.mcm.allow_ai_routing.name" text="Allow AI Dialogue and Settlement" />
    <string id="awake.mcm.allow_ai_routing.hint" text="Off by default. This is the explicit authorization switch: AWAKE only submits dialogue to the AI route, exports data by classification, and settles AI-produced relationship and world-state changes while this is on. When off, NPC dialogue stays on local fallback text." />
    <string id="awake.mcm.enable_cloud_oneclick.name" text="Enable Cloud Dialogue" />
    <string id="awake.mcm.enable_cloud_oneclick.content" text="Enable" />
    <string id="awake.mcm.enable_cloud_oneclick.hint" text="Enables AWAKE cloud export and player-state export. The embedded Runtime applies the route configuration automatically." />
    <string id="awake.mcm.actions.cloud_oneclick_ok" text="Cloud export enabled. AWAKE applies the route configuration automatically." />
    <string id="awake.mcm.actions.cloud_oneclick_session_only" text="Cloud export enabled for this session. Save the MCM settings to keep it for future sessions." />
    <string id="awake.mcm.actions.cloud_oneclick_failed" text="One-click cloud enable failed. Enable cloud export manually." />
    <string id="awake.mcm.developer_menu.name" text="Enable Developer Menu" />
    <string id="awake.mcm.developer_menu.hint" text="Disabled by default. Adds AI self-check and developer check entries in town, castle, village and keep menus." />
    <string id="awake.mcm.terminal_key.name" text="Command Deck Hotkey" />
    <string id="awake.mcm.terminal_key.hint" text="Input an InputKey name, e.g. U, K or H." />
    <string id="awake.mcm.scene_max_range.name" text="Scene Target Max Range (m)" />
    <string id="awake.mcm.scene_max_range.hint" text="Maximum search radius while holding T. Default 60. Uses 3D distance; very high values include people across walls or floors." />
    <string id="awake.mcm.scene_visual_selection.name" text="Enable Scene Visual Selection" />
    <string id="awake.mcm.scene_visual_selection.hint" text="Enabled by default. Shows the ground range, candidate outlines, and a pulsing current target while holding T." />
    <string id="awake.mcm.scene_near_to_far_key.name" text="Near-to-Far Target Key" />
    <string id="awake.mcm.scene_near_to_far_key.hint" text="Input an InputKey name or a literal [ or ] key. Default [." />
    <string id="awake.mcm.scene_far_to_near_key.name" text="Far-to-Near Target Key" />
    <string id="awake.mcm.scene_far_to_near_key.hint" text="Input an InputKey name or a literal [ or ] key. Default ]." />
    <string id="awake.mcm.scene_shout_key.name" text="Scene Shout Key" />
    <string id="awake.mcm.scene_shout_key.hint" text="While holding T, press this key to switch to an untargeted scene call. Default V." />
    <string id="awake.mcm.group.command" text="3. Command Deck" />
    <string id="awake.mcm.world_effects.name" text="Enable World Effects" />
    <string id="awake.mcm.world_effects.hint" text="Enabled by default. When disabled, optional content-pack world effects are rejected; actual gameplay wiring is planned for 0.2.x." />
    <string id="awake.mcm.boon_offers.name" text="Enable Optional Content Proposals" />
    <string id="awake.mcm.boon_offers.hint" text="Enabled by default. When disabled, optional content packs cannot generate new proposals; unsettled proposals are cleared and in-flight settlement may finish." />
    <string id="awake.mcm.npc_proactive.name" text="Enable NPC Proactive" />
    <string id="awake.mcm.npc_proactive.hint" text="Enabled by default. Nearby NPCs may proactively start a conversation based on relationship and current situation." />
    <string id="awake.mcm.npc_proactive_chance.name" text="NPC Proactive Chance" />
    <string id="awake.mcm.npc_proactive_chance.hint" text="Final variance for NPC proactive initiations, 0-100, default 35. Relationship and event conditions decide the base trigger first." />
