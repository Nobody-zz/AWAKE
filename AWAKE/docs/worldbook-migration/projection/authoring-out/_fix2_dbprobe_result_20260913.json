   "loc_cns": [
    {
     "term": "卡恰尔半岛",
     "stringId": "Settlements.Settlement.text.castle_village_S1_1",
     "text": "乌斯托科坐落于瓦尔切格湾与比亚里海之间当风的卡恰尔半岛。当地人饲养的耐寒北方牛会在石缝间找小草吃，困难时期则补充一些海藻。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "卡恰尔半岛",
     "stringId": "Settlements.Settlement.text.village_S7_2",
     "text": "卡布尔坐落于卡恰尔半岛的高原之上，多少受到了北边高耸山脊的一些庇护。当地村民们种植大麦和谷物。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "卡恰尔半岛",
     "stringId": "Settlements.Settlement.text.village_S7_3",
     "text": "哲米扬位于卡恰尔半岛北岸。这里草木葱茏，是当地地主饲养马匹的绝佳地点。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "卡恰尔",
     "stringId": "Settlements.Settlement.text.castle_village_S1_1",
     "text": "乌斯托科坐落于瓦尔切格湾与比亚里海之间当风的卡恰尔半岛。当地人饲养的耐寒北方牛会在石缝间找小草吃，困难时期则补充一些海藻。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "卡恰尔",
     "stringId": "Settlements.Settlement.text.village_S7_2",
     "text": "卡布尔坐落于卡恰尔半岛的高原之上，多少受到了北边高耸山脊的一些庇护。当地村民们种植大麦和谷物。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "卡恰尔",
     "stringId": "Settlements.Settlement.text.village_S7_3",
     "text": "哲米扬位于卡恰尔半岛北岸。这里草木葱茏，是当地地主饲养马匹的绝佳地点。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "伊卡拉荒原",
     "stringId": "Settlements.Settlement.text.castle_village_S5_1",
     "text": "奥夫是伊卡拉荒原——拉科尼斯湖西北方的森林里一处较新的斯特吉亚殖民地。村民们最初定居于此是为了寻找毛皮，但猎物大多被驱赶到森林深处，如今他们在沼泽林地里种植亚麻",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "伊卡拉荒原",
     "stringId": "Settlements.Settlement.text.castle_village_S5_2",
     "text": "费赫位于伊卡拉荒原——拉科尼斯湖西北方森林的北部边缘处。它是冒险进入森林深处的商贩的据点，那些人需要面对严寒与狼群，以及寻求毛皮、喜怒无常的林中居民，还有北地的",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "伊卡拉荒原",
     "stringId": "Settlements.Settlement.text.village_S1_1",
     "text": "罗多巴斯，“奥巴斯之屋”，得名自山上的一位亡故已久的斯特吉亚酋长。该村坐落在俯瞰伊卡拉荒原的山脊上，去山下黑暗的森林中猎取毛皮的猎人们将这里作为基地。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "伊卡拉荒原",
     "stringId": "Settlements.Settlement.text.village_S1_2",
     "text": "福林坐落于伊卡拉荒原边加尔察河附近的黑麦和大麦田旁。这里的地主把林地变成了马匹的牧场。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    }
   ],
   "loc_en_exact": []
  }
 },
