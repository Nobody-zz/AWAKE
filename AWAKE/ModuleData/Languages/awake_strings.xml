    <string id="awake.mcm.provider_kind.hint" text="Choose the AI service you use. OpenAI-compatible also works with some local services." />
    <string id="awake.mcm.provider_url.name" text="Service address" />
    <string id="awake.mcm.provider_url.hint" text="Enter the service address: an API root such as https://api.deepseek.com or https://api.openai.com/v1, or a complete endpoint pasted from the provider such as https://api.deepseek.com/chat/completions. Both are accepted. Do not put the API Key in the address." />
    <string id="awake.mcm.provider_model.name" text="Model name" />
    <string id="awake.mcm.provider_model.hint" text="Enter the model ID returned by the Provider; you can click “Fetch available models” first." />
    <string id="awake.mcm.provider_cloud.name" text="Cloud service" />
    <string id="awake.mcm.provider_cloud.hint" text="Cloud services usually require an API Key; local Ollama normally leaves this off." />
