{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "awake.worldbook.overlay.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "overlayId", "baseActivationId", "revision", "operations"],
  "properties": {
    "schemaVersion": { "const": "awake.worldbook.overlay.v1" },
    "overlayId": { "$ref": "common.schema.json#/$defs/stable_id" },
    "baseActivationId": { "$ref": "common.schema.json#/$defs/stable_id" },
    "revision": { "type": "integer", "minimum": 1 },
    "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" }, "uniqueItems": true },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "targetId", "kind", "baseRevision"],
      "properties": {
        "operationId": { "$ref": "common.schema.json#/$defs/stable_id" },
        "targetId": { "$ref": "common.schema.json#/$defs/stable_id" },
        "kind": { "enum": ["replace_text", "replace_title", "replace_summary", "add_keyword", "remove_keyword", "disable_expression", "enable_expression"] },
        "baseRevision": { "type": "integer", "minimum": 1 },
        "value": { "type": ["string", "boolean"] },
        "locale": { "type": "string", "pattern": "^[a-z]{2}(?:-[A-Z][a-z]+)?$" },
        "reason": { "$ref": "common.schema.json#/$defs/localized" }
      }
    }
  }
}
