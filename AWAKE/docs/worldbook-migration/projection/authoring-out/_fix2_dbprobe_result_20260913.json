{
 "charas-bay": {
  "en_terms": [
   "Charas Bay"
  ],
  "zh_terms": [
   "沙拉斯湾",
   "加隆托海峡",
   "沙拉斯港"
  ],
  "extra_en": [],
  "hits": {
   "settlement_desc": [],
   "loc_cns": [
    {
     "term": "沙拉斯湾",
     "stringId": "Settlements.Settlement.text.castle_village_A1_1",
     "text": "突比力斯位于沙拉斯湾，阿塞莱人亦称此地为沙瑞兹。村民们会驾船前往岛屿间的浅滩，寻找并捕捞金枪鱼、沙丁鱼和鲨鱼。",
     "fp": "Modules/Native/ModuleData/Languages/CNs/std_common_strings_xml-zho-CN.xml"
    },
    {
     "term": "沙拉斯湾",
     "stringId": "Settlements.Settlement.text.castle_village_EW1_1",
     "text": "位于沙拉斯湾和珀拉斯内海间的海角以加隆托为名。沿海草甸茂盛，这些较高的草对海水盐质的耐受性不错，可用来饲养优良的马匹。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "沙拉斯湾",
     "stringId": "Settlements.Settlement.text.castle_village_EW4_1",
     "text": "色雷刻托坐落于汇入沙拉斯湾的一片小海湾旁。此地受南方热风的吹拂和山泉的滋润，被帝国的地主们用来进行椰枣树的试验性种植。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "沙拉斯湾",
     "stringId": "Settlements.Settlement.text.castle_village_V1_1",
     "text": "于桑克坐落于汇入沙拉斯湾的一片小海湾旁。这片温暖的南方土地很适合种植橄榄树。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    },
    {
     "term": "沙拉斯湾",
     "stringId": "Settlements.Settlement.text.village_EW3_1",
     "text": "伽玛耳丹位于一片小海湾的头端，那片小海湾则由更大的沙拉斯湾分出。金枪鱼在近海聚集产卵，当地渔民先用渔网将这群大鱼围住，再用钩具将其拖拽上船。",
     "fp": "Modules/SandBox/ModuleData/Languages/CNs/std_settlements_xml-zho-CN.xml"
    }
   ],
   "loc_en_exact": []
  }
 },
