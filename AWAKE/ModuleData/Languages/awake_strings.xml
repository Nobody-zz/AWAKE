    <string id="awake.mcm.ai_status.name" text="AI Link Status" />
    <string id="awake.mcm.ai_status.hint" text="Read-only: Companion connection, route capabilities and candidate providers. Configure Provider under MCM → Marcus AI Framework → 01 Companion; use the four logical routes from the README." />
    <string id="awake.mcm.cloud_export.name" text="Enable Cloud Export" />
    <string id="awake.mcm.cloud_export.hint" text="Disabled by default. Even when enabled, the classification switch and framework permission must both allow the category before it is sent to a cloud AI." />
    <string id="awake.mcm.export_player_state.name" text="Allow Player State Export" />
    <string id="awake.mcm.export_player_state.hint" text="Allows player, hero and relationship state to be exported as player_state in goddess dialogue. Disabled by default." />
    <string id="awake.mcm.developer_menu.name" text="Enable Developer Menu" />
    <string id="awake.mcm.developer_menu.hint" text="Disabled by default. Adds AI self-check and developer check entries in town, castle, village and keep menus." />
    <string id="awake.mcm.terminal_key.name" text="Command Deck Hotkey" />
    <string id="awake.mcm.terminal_key.hint" text="Input an InputKey name, e.g. Y, K or H." />
    <string id="awake.mcm.scene_max_range.name" text="Scene Target Max Range (m)" />
    <string id="awake.mcm.scene_max_range.hint" text="Maximum search radius while holding T. Default 60. Uses 3D distance; very high values include people across walls or floors." />
    <string id="awake.mcm.group.command" text="Command Deck" />
    <string id="awake.mcm.world_effects.name" text="Enable World Effects" />
    <string id="awake.mcm.world_effects.hint" text="Enabled by default. When disabled, world commands and oracle effects from goddess output are rejected; actual gameplay wiring is planned for 0.2.x." />
    <string id="awake.mcm.boon_offers.name" text="Enable Divine Proposals" />
    <string id="awake.mcm.boon_offers.hint" text="Enabled by default. When disabled, no new divine candidates are generated, unsettled proposals are cleared, and in-flight settlement may finish." />
    <string id="awake.mcm.npc_proactive.name" text="Enable NPC Proactive" />
    <string id="awake.mcm.npc_proactive.hint" text="Disabled by default. When enabled, NPCs may proactively approach based on estrus and relationship state; chance is controlled by the next option." />
    <string id="awake.mcm.npc_proactive_chance.name" text="NPC Proactive Chance" />
    <string id="awake.mcm.npc_proactive_chance.hint" text="Chance percentage for NPC proactive initiations, 0-100, default 35." />
    <string id="awake.mcm.event_engine.name" text="Enable Event Engine" />
    <string id="awake.mcm.event_engine.hint" text="Enabled by default. The event engine owns triggers, cooldowns and dialogue-action queues; concrete events are registered by content packs later." />
