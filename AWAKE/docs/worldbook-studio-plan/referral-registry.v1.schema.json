{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"awake.worldbook.referral-registry.v1",
  "type":"object",
  "additionalProperties":false,
  "required":["registry_id","registry_version","referrals"],
  "properties": {
    "registry_id":{"const":"awake.referral.registry"},
    "registry_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "referrals":{"type":"array","minItems":1,"uniqueItems":true,"items":{
      "type":"object","additionalProperties":false,"required":["id","display","publicly_askable"],
      "properties":{
        "id":{"type":"string","pattern":"^referral\\.[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
        "display":{"type":"object","minProperties":1,"additionalProperties":{"type":"string","minLength":1}},
        "publicly_askable":{"type":"boolean"}
      }
    }}
  }
}
