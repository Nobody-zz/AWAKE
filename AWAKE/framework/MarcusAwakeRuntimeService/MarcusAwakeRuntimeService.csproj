<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MarcusAwakeRuntimeService</RootNamespace>
    <AssemblyName>MarcusAwakeRuntimeService</AssemblyName>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU1702</NoWarn>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <UseAppHost>true</UseAppHost>
    <OutputPath>$(MSBuildThisFileDirectory)_build_out\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MarcusAwakeStorage\MarcusAwakeStorage.csproj" />
    <ProjectReference Include="..\MarcusAwakeFramework\MarcusAwakeFramework.csproj" />
    <Compile Include="src\**\*.cs" />
    <ProjectReference Include="..\MarcusAwakeTransport\MarcusAwakeTransport.csproj" />
  </ItemGroup>
</Project>
